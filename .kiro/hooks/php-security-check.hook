{
  "enabled": true,
  "name": "PHP Security Check",
  "description": "Analyzes PHP code for security vulnerabilities when saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.php"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "You are a PHP security expert. The user has just saved a PHP file. Please:\n\n1. Check for SQL injection vulnerabilities\n2. Verify proper input sanitization\n3. Look for XSS vulnerabilities\n4. Ensure proper authentication checks\n5. Check for file upload security issues\n\nIf you find any security issues, explain them clearly and suggest fixes. If the code looks secure, confirm that it follows security best practices."
  }
}
