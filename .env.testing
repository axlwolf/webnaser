# Testing Environment Configuration - Grupo Naser CMS

# Application
APP_NAME="Grupo Naser CMS - Testing"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# Database (Testing)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naser_cms_test
DB_USER=test_user
DB_PASSWORD=test_password

# JWT (Testing)
JWT_SECRET=test_jwt_secret_for_phpunit_testing_2024
JWT_EXPIRE=3600

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload (Testing)
MAX_UPLOAD_SIZE=16M
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Email (Testing - Disabled)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=test_password
MAIL_FROM_ADDRESS=test@naser.com.mx
MAIL_FROM_NAME="Grupo Naser Test"

# API Configuration
API_VERSION=v1
API_TIMEOUT=10

# Security (Testing)
BCRYPT_ROUNDS=4
SESSION_LIFETIME=60

# Cache (Testing)
CACHE_DRIVER=array
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging (Testing)
LOG_LEVEL=error
LOG_MAX_FILES=1