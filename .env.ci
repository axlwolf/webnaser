# CI/CD Environment Configuration - Grupo Naser CMS

# Application
APP_NAME="Grupo Naser CMS - CI"
APP_ENV=testing
APP_DEBUG=false
APP_URL=http://localhost

# Database (CI)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naser_cms_test
DB_USER=root
DB_PASSWORD=test_password

# JWT (CI)
JWT_SECRET=ci_jwt_secret_for_github_actions_testing_2024
JWT_EXPIRE=3600

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload (CI)
MAX_UPLOAD_SIZE=16M
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Email (CI - Disabled)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=ci@example.com
MAIL_PASSWORD=ci_password
MAIL_FROM_ADDRESS=ci@naser.com.mx
MAIL_FROM_NAME="Grupo Naser CI"

# API Configuration
API_VERSION=v1
API_TIMEOUT=10

# Security (CI)
BCRYPT_ROUNDS=4
SESSION_LIFETIME=60

# Cache (CI)
CACHE_DRIVER=array
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging (CI)
LOG_LEVEL=error
LOG_MAX_FILES=1